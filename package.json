  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc -w & node --watch dist/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\" \"*.{json,md}\" \".github/workflows/*.yml\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"*.{json,md}\" \".github/workflows/*.yml\""
  },
  "dependencies": {
    "@mra1k3r0/gramora": "^0.0.16",
    "dotenv": "^16.5.0",
    "expr-eval": "^2.0.2",
