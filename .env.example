TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
BOT_ADMIN_IDS=123456789
YOUTUBE_COOKIE=your_youtube_cookie_here
YOUTUBE_VISITOR_DATA=optional_visitor_data
# Transport + webhook can also live in bot.config.jsonc (`transport`, `webhook`). Env overrides file.
BOT_TRANSPORT=polling
WEBHOOK_PORT=3000
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PATH=/webhook
WEBHOOK_DOMAIN=
WEBHOOK_SECRET=
# Auto-open a public HTTPS tunnel when WEBHOOK_DOMAIN is empty.
WEBHOOK_TUNNEL=false
WEBHOOK_TUNNEL_PROVIDER=localtunnel
# Optional localtunnel settings when provider is localtunnel
# WEBHOOK_LOCALTUNNEL_HOST=https://localtunnel.me
# WEBHOOK_LOCALTUNNEL_SUBDOMAIN=
# Optional ngrok auth token when provider is ngrok
# NGROK_AUTHTOKEN=
# Optional localexpose settings when provider is localexpose
# LOCALEXPOSE_BIN=loclx
# LOCALEXPOSE_AUTH_TOKEN=
# LOCALEXPOSE_DOWNLOAD_BASE=https://api.localxpose.io/api/v2/downloads
