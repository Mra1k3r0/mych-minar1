{
  // Config file for non-secret settings. Comments supported (JSONC).
  // Secrets should stay in .env (API keys / Telegram token).

  "llm": {
    // provider:
    // - "openai_compatible" (Groq, OpenAI, any OpenAI-style /chat/completions)
    // - "anthropic" (Claude via /v1/messages)
    "provider": "openai_compatible",

    // For openai_compatible:
    "baseUrl": "https://api.groq.com/openai/v1",
    "model": "openai/gpt-oss-120b",
    // Optional fallback rotation list (tried in order on retryable failures).
    // Keep provider/baseUrl compatible with the models below.
    "models": [
      "openai/gpt-oss-120b",
      "moonshotai/kimi-k2-instruct",
      "moonshotai/kimi-k2-instruct-0905",
      "qwen/qwen3-32b"
    ],
    "apiKeyEnv": "GROQ_API_KEY",

    // Limits (tune per provider/free tier)
    "limits": {
      "requestsPerMinute": 30,
      "requestsPerDay": 1000,
      "tokensPerMinute": 8000,
      "tokensPerDay": 200000
    }

    // For anthropic:
    // "baseUrl": "https://api.anthropic.com",
    // "model": "claude-3-5-sonnet-20241022",
    // "apiKeyEnv": "ANTHROPIC_API_KEY"
  },

  "bot": {
    // Telegram transport: polling (default) or webhook. Same as env BOT_TRANSPORT.
    "transport": "webhook",

    // Webhook listen URL + Telegram setWebhook target. Env WEBHOOK_* overrides these when set.
    // Prefer keeping "secret" in .env as WEBHOOK_SECRET for production.
    "webhook": {
      "port": 3000,
      "host": "0.0.0.0",
      "path": "/webhook",
      //   "domain": "https://your-public-host.example.com",
      "tunnel": true, // local-dev shortcut when no domain is set
      "tunnelProvider": "localtunnel", // or "cloudflared" | "ngrok" | "localexpose"
      // Optional advanced per-provider tuning (all fields optional)
      "tunnelOptions": {
        "localtunnel": {
          // "host": "https://localtunnel.me",
          // "subdomain": "my-bot-dev",
          // "localHttps": false
        },
        "cloudflared": {
          // "binaryPath": "auto" // default: auto detect by OS/arch + cache/download
          // set a fixed path only if you want to force your own binary location.
          // "binaryPath": "C:/tools/cloudflared.exe"
        },
        "ngrok": {
          // "authtoken": "your_ngrok_token",
          // "binaryPath": "auto" // default: auto detect by OS/arch + cache/download
          // set a fixed path only if auto-detect is not what you want.
          // "binaryPath": "C:/tools/ngrok.exe"
        },
        "localexpose": {
          // "authToken": "your_localexpose_token",
          // "binaryPath": "auto" // default: auto detect by OS/arch + cache/download
          // set a fixed path only if you need a custom installed binary.
          // "binaryPath": "C:/tools/loclx.exe",
          // "region": "ap",
          // "subdomain": "my-temp-subdomain",
          // "reservedDomain": "myreserved.loclx.io"
        }
      }
      //"secret": ""
    },

    // Conversation memory size per user
    "maxConversationHistory": 20,
    // Agent tool-calling iterations
    "maxAgentIterations": 5,
    // LLM token/call saving mode:
    // - "auto": enable low-token behavior only when budget gets tight
    // - "always": always use low-token behavior (best for strict free-tier usage)
    // - "off": disable low-token behavior
    "lowTokenMode": "auto",

    // Prompt layering (inspired by claude-code):
    // - systemPromptOverride: replaces the entire default prompt
    // - systemPromptAppend: appended after the chosen base prompt
    // - systemPrompt: (legacy) if set, acts like systemPromptOverride
    // "systemPromptOverride": "You are ...",
    // "systemPromptAppend": "Extra rules for this deployment...",
    // "systemPrompt": "LEGACY (same as override)"

    // Telegram anti-spam middleware (messages/user/minute)
    "telegramUserRpmLimit": 15
  }
}
