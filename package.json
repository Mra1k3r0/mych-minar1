    "undici": "^8.0.2",
    "youtubei.js": "^17.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.15.2",
    "eslint": "^10.2.1",
    "globals": "^17.5.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.59.0"
  }
